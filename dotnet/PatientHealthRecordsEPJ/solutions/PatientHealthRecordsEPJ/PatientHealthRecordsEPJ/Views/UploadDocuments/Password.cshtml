@using PatientHealthRecordsEPJ.Controllers

@model PasswordModel

@{
	var sessionData = Context.Session.SessionData();	
}

<style>
	.error {
		padding: 10px;
		color: red;
		margin: 5px;
		background-color: #ddd;
		border: 1px solid red;
	}
</style>

<div class="container-fluid max">

	<form method="post">
		<h4>
			<i class="bi bi-key fs-3 text-primary"></i> Passord for å åpne tilgang til å laste opp dokumenter
		</h4>

		@if (Model.IsPasswordInvalid)
		{
			<div class="error">
				Passordet er feil. 
			</div>
		}

		<p>
			For å få tilgang til å laste opp dokumenter så må du få et passord fra NHN. Kontakt oss i #ext-nhn-pasientens-journaldokumenter (for eksterne) eller #drift-pjd-intern (NHN internt) for å få vite passordet.
		</p>	
		
		<p>
			Dette er for å beskytte mot misbruk. 
		</p>

		<div class="row mb-3">
			<label for="inputPassword" class="col-sm-2 col-form-label">Passord:</label>
			<div class="col-sm-2">				
				<input asp-for="Password" type="password" class="form-control" id="inputPassword">
			</div>
			
		</div>

		<button type="submit" class="btn btn-primary">Åpne tilgang</button>

	</form>

</div>

