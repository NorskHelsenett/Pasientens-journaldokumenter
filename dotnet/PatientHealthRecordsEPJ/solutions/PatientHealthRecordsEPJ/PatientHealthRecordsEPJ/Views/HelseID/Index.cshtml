@model HelseIdViewModel

@{
	var sessionData = Context.Session.SessionData();	
}

<style>
	.head {
		font-size: 11px;
		font-style: italic;
	}
		
	textarea {
		position: relative;
		color: black;
		height: auto;
	}	

	#encodedtoken
	{
		font-family: monospace;
		/* font-size: 14px;
		line-height: 1.5; */
		white-space: pre-wrap; 
		word-break:break-all; 
		min-height:100px; 
		border: 1px solid #aaa; 
		padding:10px; 
		font-size:14px; 
	}

	.jwtHeader
	{
		color: #B00; 
	}

	.jwtClaims
	{
		color: #00B; 
	}

	.jwtSignature {
		color: #090; 
	}

</style>

<div style="max-width:1900px;margin:0 auto">

	<h4 class="display-6">Helse ID</h4>

	<div style="display:flex;gap:40px">
		<div>

			<h5>Innlogget som:</h5>
			<div>
				<h6>@sessionData.Name / @sessionData.AuthorizationName - @sessionData.OrganizationName</h6>
			</div>
		</div>

		<div>

			<h5>Pasient:</h5>

			<div>
				<h6>@sessionData.PatientName <span style="font-size:14px;">(@sessionData.PatientId) @* / Kvinne (33 år) *@</span></h6>
			</div>
		</div>
	</div>

	<br />

	@if (!Model.IsSuccess)
	{
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					Error: @Model.ErrorMessage
				</div>
			</div>
		</div>
	}
	else
	{	
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					
					@* PHR Access Token *@

					<details>
						<summary class="fs-3">HelseID access token - Patient Health Records API (nhn:phr)</summary>

						<h5>HelseID access token</h5>
						@{
							var tokenParts = Model.PhrAccessToken?.Split('.');

							var jwtHeader = tokenParts != null && tokenParts.Length > 0 ? tokenParts[0] : string.Empty;
							var jwtClaims = tokenParts != null && tokenParts.Length > 1 ? tokenParts[1] : string.Empty;
							var jwtSignature = tokenParts != null && tokenParts.Length > 2 ? tokenParts[2] : string.Empty;
						}

						<div id="encodedtoken"><span class="jwtHeader">@jwtHeader</span>.<span class="jwtClaims">@jwtClaims</span>.<span class="jwtSignature">@jwtSignature</span></div>

						<hr />

						<h5>Decoded token (claims only)</h5>

						<textarea class="w-100" rows="50">@Model.PhrJwtToken</textarea>

					</details>
					

					@* Repository Access Token *@

					<details>
						<summary class="fs-3">HelseID access token - NHN Dokumentlager API (nhn:repo)</summary>

						<h5>HelseID access token</h5>
						@{
							tokenParts = Model.RepositoryAccessToken ?.Split('.');

							jwtHeader = tokenParts != null && tokenParts.Length > 0 ? tokenParts[0] : string.Empty;
							jwtClaims = tokenParts != null && tokenParts.Length > 1 ? tokenParts[1] : string.Empty;
							jwtSignature = tokenParts != null && tokenParts.Length > 2 ? tokenParts[2] : string.Empty;
						}

						<div id="encodedtoken"><span class="jwtHeader">@jwtHeader</span>.<span class="jwtClaims">@jwtClaims</span>.<span class="jwtSignature">@jwtSignature</span></div>

						<hr />

						<h5>Decoded token (claims only)</h5>

						<textarea class="w-100" rows="50">@Model.RepositoryJwtToken</textarea>
					</details>
					

					@* PHR Service Access Token *@

					<details>
						<summary class="fs-3">HelseID access token - Pasientens journaldokumenter støttetjenester API (nhn:phr-svc)</summary>

						<h5>HelseID access token</h5>
						@{
							tokenParts = Model.ServiceAccessToken?.Split('.');

							jwtHeader = tokenParts != null && tokenParts.Length > 0 ? tokenParts[0] : string.Empty;
							jwtClaims = tokenParts != null && tokenParts.Length > 1 ? tokenParts[1] : string.Empty;
							jwtSignature = tokenParts != null && tokenParts.Length > 2 ? tokenParts[2] : string.Empty;
						}

						<div id="encodedtoken"><span class="jwtHeader">@jwtHeader</span>.<span class="jwtClaims">@jwtClaims</span>.<span class="jwtSignature">@jwtSignature</span></div>

						<hr />

						<h5>Decoded token (claims only)</h5>

						<textarea class="w-100" rows="50">@Model.ServiceJwtToken </textarea>
					</details>
				
				</div>
			</div>

			<div class="row">
				<div class="col-md-12">

					

				</div>
			</div>		
		</div>
	}
</div>


