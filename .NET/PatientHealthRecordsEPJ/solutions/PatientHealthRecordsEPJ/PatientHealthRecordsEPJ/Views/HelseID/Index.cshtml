@model HelseIdViewModel

@{
	var sessionData = Context.Session.SessionData();	
}

<style>
	.head {
		font-size: 11px;
		font-style: italic;
	}
		
	textarea {
		position: relative;
		color: black;
		height: auto;
	}	

</style>

<div style="max-width:1900px;margin:0 auto">

	<h4 class="display-6">Helse ID</h4>

	<div style="display:flex;gap:40px">
		<div>

			<h5>Innlogget som:</h5>
			<div>
				<h6>@sessionData.Name / @sessionData.AuthorizationName - @sessionData.OrganizationName</h6>
			</div>
		</div>

		<div>

			<h5>Pasient:</h5>

			<div>
				<h6>@sessionData.PatientName <span style="font-size:14px;">(@sessionData.PatientId) @* / Kvinne (33 år) *@</span></h6>
			</div>
		</div>
	</div>

	<br />

	@if (!Model.IsSuccess)
	{
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					Error: @Model.ErrorMessage
				</div>
			</div>
		</div>
	}
	else
	{	
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">

					<h5>HelseID access token</h5>					

					<textarea class="w-100" rows="5">@Model.AccessToken</textarea>

				</div>
			</div>

			<div class="row">
				<div class="col-md-12">

					<hr />

					<h5>Decoded token</h5>					

					<textarea class="w-100" rows="50">@Model.JwtToken</textarea>

				</div>
			</div>		
		</div>
	}
</div>


