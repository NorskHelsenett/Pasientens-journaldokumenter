@{

	var sessionData = Context.Session.SessionData();

	var isDebug = false;
	var isShowDokumentlagerTests = false; 

#if DEBUG
	isDebug = true;
	isShowDokumentlagerTests = true; 
#endif

}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Pasientens journaldokumenter EPJ</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/PatientHealthRecordsEPJ.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<style>
		.btn-primary {
		background-color: #015945;
		border: none;
		}

		.btn-primary:hover {
		background-color: #01755B;
		}

		.logo {
		background-color: #015945;
		display: inline-block;
		padding: 3px 10px;
		border-radius: 4px;
		color: #fff;
		}

		.navbar-brand {
		font-weight: bold;
		}

		.environment {
		padding: 3px 40px;
		border-radius: 6px;
		font-weight: bold;
		}

		.environment.empty {
		background-color: #aaa;
		color: #fff;
		}

		.environment.devtest {
			background-color: dodgerblue;
			color: #fff;
		}

		.environment.test {
		background-color: red;
		color: #fff;
		}

		.environment.qa {
			background-color: darkmagenta;
			color: #fff;
		}

		.environment.qa-geo {
			background-color: darkmagenta;
			color: #fff;
		}

		.environment.prod {
		}
	</style>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><div class="logo">Pasientens journaldokumenter EPJ</div></a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<style>
					.navbar-nav .nav-link:hover {
					text-decoration: underline;
					}
				</style>

				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">

						@{
							var selectedClass = "fw-bold text-decoration-underline";
							var selected = "";
							var path = Context.Request.Path.ToString().ToLower();

							selected = path == "/" ? selectedClass : string.Empty;
						}
						
						<li class="nav-item">
							<a class="nav-link text-dark @selected" asp-area="" asp-controller="Home" asp-action="Index">Hjem</a>
						</li>
						@* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li> *@

						@if (sessionData.IsAuthenticated)
						{

							selected = path.StartsWith("/documents") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="Documents" asp-action="Index">Journaldokumenter</a>
							</li>
							
							selected = path.StartsWith("/uploaddocuments") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="UploadDocuments" asp-action="Index">Dokumentlager</a>
							</li>

							selected = path.StartsWith("/status") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="Status" asp-action="Index">Status</a>
							</li>

							selected = path.StartsWith("/saml") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="Saml" asp-action="ShowSamlAssertion">SAML billett</a>
							</li>
							
							selected = path.StartsWith("/atna") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="AtnaLog" asp-action="Index">ATNA logg</a>
							</li>

							selected = path.StartsWith("/helseid") ? selectedClass : string.Empty;

							<li class="nav-item">
								<a class="nav-link text-dark @selected" asp-area="" asp-controller="HelseId" asp-action="Index">HelseID@*  token *@</a>
							</li>

							selected = path.StartsWith("/dokumentlagertest") ? selectedClass : string.Empty;

							@if (isShowDokumentlagerTests)
							{
								<li class="nav-item">
									<a class="nav-link text-dark @selected" asp-area="" asp-controller="DokumentlagerTest" asp-action="Index">Dokumentlager Test</a>
								</li>
							}

							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Logout">Logg ut</a>
							</li>
						}
						@* else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Login">Logg inn</a>
                            </li>
                        } *@



					</ul>

					<ul class="navbar-nav ms-auto">
						@if (sessionData.IsAuthenticated)
						{
							<li classs="nav-item">
								<div style="margin-right:20px;color:darkgoldenrod">
									@sessionData.Name (@sessionData.PersonId) @* <a href="/Home/Logout"><i class="bi bi-arrow-bar-right" style=""></i></a> *@<br />
									@* <a href="/Home/Logout"><i class="bi bi-arrow-bar-left fs-6" style=""></i>Logout @sessionData.Name (@sessionData.PersonId) </a><br /> *@
									Pasient: <a href="/">@sessionData.PatientName</a>
								</div>
							</li>
						}
						<li class="nav-item">
							<strong>Miljø:</strong>

							@if (string.IsNullOrEmpty(sessionData.EnvironmentId))
							{
								<span class="environment empty"><em>ikke valgt</em></span>
							}
							else
							{
								@* TODO: fix colors on different environmentst *@
								@if (sessionData.EnvironmentId == "devtest")
								{
									<span class="environment devtest">@sessionData.EnvironmentName</span>
								}
								else if (sessionData.EnvironmentId == "test")
								{
									<span class="environment test">@sessionData.EnvironmentName</span>
								}
								else if (sessionData.EnvironmentId == "qa")
								{
									<span class="environment qa">@sessionData.EnvironmentName</span>
								}								
								else if (sessionData.EnvironmentId == "prod")
								{
									<span class="environment prod">@sessionData.EnvironmentName</span>
								}

								if (sessionData.IsAuthenticated && !string.IsNullOrWhiteSpace(sessionData.PatientId))
								{
									<br />
																											
									var hnEnvironmentName = string.Empty; 
									var hnLoginUrl = string.Empty;

									switch (sessionData.EnvironmentId)
									{
										case "devtest":									
											hnEnvironmentName = "Test01";
											hnLoginUrl = "https://tjenester.hn.test.nhn.no/?pnr=" + sessionData.PatientId;  // Test01
											break;									
										case "test":
											hnEnvironmentName = "Test01";
											hnLoginUrl = "https://tjenester.hn.test.nhn.no/?pnr=" + sessionData.PatientId;  // Test01
											break;
										case "qa":
											hnEnvironmentName = "Test02";
											hnLoginUrl = "https://tjenester.hn2.test.nhn.no/?pnr=" + sessionData.PatientId;  // Test02
											break;
										default:
											hnEnvironmentName = "Test01";
											hnLoginUrl = "https://tjenester.hn.test.nhn.no/?pnr=" + sessionData.PatientId;  // Test01
											break;
									}; 							
												
									<a href="@hnLoginUrl" target="_blank">Helsenorge &rarr;</a><br />
								}

							}
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>
	<div class="container-fluid">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			<div class="row">
				<div class="col-md-4">
					Pasientens journaldokumenter REST API - EPJ @* - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
				</div>

				<div class="col-md-4" style="font-weight:bold">
					@* @if (ViewBag.SessionTimeLeft != null && sessionLoginResult.IsAuthenticated)
					{
						var remaining = (TimeSpan)ViewBag.SessionTimeLeft;
						<span>Session expires in: </span>

						@if (@remaining.Hours > 0)
						{
							<span>@remaining.Hours hours, </span>
						}
						<span>@remaining.Minutes min, @remaining.Seconds sec</span>
					} *@

					@if (ViewBag.SessionExpiresAt != null && sessionData.IsAuthenticated)
					{
						var expiresAt = (DateTime)ViewBag.SessionExpiresAt;
						<span>Sesjon utløper kl @expiresAt.ToString("HH:mm:ss")</span>
					}
				</div>

				<div class="col-md-4">
					<a href="https://github.com/NorskHelsenett/Pasientens-journaldokumenter" target="_blank">Kildekode på Github</a>
				</div>
			</div>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
