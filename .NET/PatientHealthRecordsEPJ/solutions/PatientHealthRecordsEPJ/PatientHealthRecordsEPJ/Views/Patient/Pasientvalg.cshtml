@model PasientvalgViewModel

@{	
	var sessionData = Context.Session.SessionData();
}


@if (sessionData.IsAuthenticated)
{

	<form method="post" asp-action="VelgPasient">
		<div class="container">

			<div class="row">
				<div class="col-md-12">

					<div class="text-center fs-3">
						Bruker: @sessionData.Name (@sessionData.PersonId)<br />
						Lovverk/scope for å hente dokumentliste: @sessionData.DocumentListScopeName
					</div>

					<br />

				</div>
			</div>

			<div class="row">
				<div class="col-md-4">
					@* <div>
						<strong>Pasient</strong>
					</div>
					<div>
						<input asp-for="PatientId" class="w-100" value="@Model.PatientId" />
					</div> *@

					 <div>
						<strong>Pasient (F-nummer eller D-nummer):</strong>
					</div>
					<div>
						<input asp-for="PatientId" class="w-100" value="@Model.PatientId" />
					</div> 

					<div>
						<br />
						<strong>Eller velg fra liste:</strong><br />
						
						<button type="submit" class="btn btn-info mb-2" asp-action="VelgPasient" asp-route-nin="56856300299"><i class="bi bi-gender-female fs-5"></i> SAKTE SØSTER (D-nummer)</button>&nbsp;
						<button type="submit" class="btn btn-info mb-2" asp-action="VelgPasient" asp-route-nin="12909598867"><i class="bi bi-gender-female fs-5"></i> LIKEGYLDIG KAHYTT BRØDSKIVE (Mellomnavn)</button>
						
						<br />
						<strong>Testpersoner Nasjonalt lager:</strong><br />
						<button type="submit" class="btn btn-info mb-2" asp-action="VelgPasient" asp-route-nin="22876699307"><i class="bi bi-gender-male fs-5"></i> LIVSGLAD KREPS (F-nummer)</button>&nbsp;
						<button type="submit" class="btn btn-info mb-2" asp-action="VelgPasient" asp-route-nin="17855599120"><i class="bi bi-gender-female fs-5"></i> USNOBBET KLOKKE (F-nummer)</button>
						<button type="submit" class="btn btn-info mb-2" asp-action="VelgPasient" asp-route-nin="08777634659"><i class="bi bi-gender-female fs-5"></i> ULYDIG BOLLE (F-nummer)</button>
						
						@* <button class="btn btn-info" @onclick ="() => producePatientLineDanser()"><Icon Name="IconName.GenderFemale" Size="IconSize.x5" /> Line Danser</button> *@
						<br />
						<br />
					</div>
				</div>

				<div class="col-md-8">				
					<div>
						<strong>Grunnlag</strong>
					</div>
					<div>
						@if (sessionData.DocumentListScopeId == (int)DocumentListScopeEnum.Kjernejournalforskriften)
						{
							<select asp-for="GrunnlagId"
									asp-items="@(new SelectList(PasientvalgViewModel.GrunnlagList , nameof(OptionPair.Id), nameof(OptionPair.Label)))"
									class="w-100">
							</select>
						}
						else
						{
							<div>Grunnlag kreves ikke ved bruk av scope for Helsepersonelloven &sect; 45</div>
						}
					</div>
				</div>

				@* 	<div class="col-md-4">
			<div>
			<strong>Miljø</strong>
			</div>
			<div>
			<select asp-for="EnvironmentId"
			asp-items="@(new SelectList(PasientvalgViewModel.EnvironmentList, nameof(EnvironmentPair.Id), nameof(EnvironmentPair.Label)))"
			class="w-100">
			</select>
			</div>
			</div> *@
			</div>



			<div class="row">
				<div class="col-md-12 text-center pt-3">
					<button type="submit" class="btn btn-primary">Neste </button>
				</div>
			</div>

		</div>
	</form>
}