@using PatientHealthRecordsEPJ.UploadDocuments.Models
@model ClassificationViewModel

@{
	var sessionData = Context.Session.SessionData();
}

<partial name="_WizardHeaderPartial" model="4" />

<div class="container-fluid max">

	<form method="post">

		<input type="hidden" asp-for="Metadata.FormatCode" /> <!-- Make sure to also include and save this so it's not overwritten with null when we save -->
		<input type="hidden" asp-for="Metadata.UniqueId" /> <!-- Make sure to also include and save this so it's not overwritten with null when we save -->
		<input type="hidden" asp-for="Metadata.PatientId" />
		<input type="hidden" asp-for="Metadata.SourcePatientId" />

		@* 	public PersonName Name { get; set; } = new(); // PID-5 => "PID-5|Family_name^First_name^Middle_name^^^"
        public DateTime DateOfBirth { get; set; } //PID-7 => "PID-7|19650715"
        public string? Gender { get; set; } // PID-8 => "PID-8|M"
        public string? NIN { get; set; } // Personal identifier
        public string? NinType { get; set; } // F-number or others (D-number, FHNumber), value: "Dnumber" | "NationalIdentityNumber"
		public string? XdsGlobalIdentifier { get; set; } // Unique global identifier from XDS-environment
        public string? XdsHomeCommunity { get; set; } // Known OID by XDS-environmemt

		[Required(AllowEmptyStrings = false)]
		public string? FirstName { get; set; }
		[Required(AllowEmptyStrings = false)]
		public string FamilyName { get; set; } = string.Empty;
		public string? MiddleName { get; set; }
 *@


		@* <input type="hidden" asp-for="Metadata.SourcePatientInfo.DateOfBirth" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.Gender" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.NIN" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.NinType" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.XdsGlobalIdentifier" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.XdsHomeCommunity" />
		
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.Name.FirstName" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.Name.FamilyName" />
		<input type="hidden" asp-for="Metadata.SourcePatientInfo.Name.MiddleName" /> *@


		<div class="row">
			<div class="col-md-4 documents">

				<partial name="Steps\_SelectDocument" />


			</div>
			<div class="col-md-8">

				<!-- Encounter information -->

				<h4>
					<i id="AR1O9DG8K4UJP" class="bi bi-buildings-fill fs-1 text-primary"></i> Encounter information:
				</h4>

				<div class="row mb-3">
					<label for="inputEmail3" class="col-sm-2 col-form-label">Type of healthcare facility:</label>
					<div class="col-sm-10">
						@* <input type="email" class="form-control" id="inputEmail3"> *@
						<select asp-for="Metadata.HealthCareFacilityType"
								asp-items="Model.SelectHealthcareFacilityList"
								class="form-control">
							<option value="">-- Select type of healthcare facility --</option>
						</select>
					</div>
				</div>
				<div class="row mb-3">
					<label for="inputPassword3" class="col-sm-2 col-form-label">Practice Setting:</label>
					<div class="col-sm-10">
						<select asp-for="Metadata.PracticeSettingCode"
								asp-items="Model.SelectPracticeSettingCodeList"
								class="form-control">
							<option value="">-- Select type of healthcare practice --</option>
						</select>
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label">Treatment:</label>
					<div class="col-sm-10">
						<div class="row">
							<div class="col-sm-4 d-flex align-items-center">
								<strong class="me-2" style="white-space:nowrap">From-date:</strong>
								<input asp-for="Metadata.ServiceStartTime" type="date" class="form-control" id="inputServiceStartTime">
							</div>
							<div class="col-sm-4 d-flex align-items-center">
								<strong class="me-2" style="white-space:nowrap">To-date:</strong>
								<input asp-for="Metadata.ServiceStopTime" type="date" class="form-control" id="inputServiceStopTime">
							</div>
						</div>
					</div>
				</div>


				<!-- Document classification -->

				<h4>
					<i id="AR1O9DG8K4UJQ" class="bi bi-file-richtext-fill fs-1 text-primary"></i>
					Document classification:
				</h4>

				<div class="row mb-3">
					<label for="inputPassword3" class="col-sm-2 col-form-label">Document classification:</label>
					<div class="col-sm-10">
						<select asp-for="Metadata.ClassCode"
								asp-items="Model.SelectClassificationList"
								class="form-control">
							<option value="">-- Select document category --</option>
						</select>
					</div>
				</div>

				<div class="row mb-3">
					<label for="inputPassword3" class="col-sm-2 col-form-label">Document category type:</label>
					<div class="col-sm-10">
						<select asp-for="Metadata.TypeCode"
								asp-items="Model.SelectCategoryTypeList"
								class="form-control">
							<option value="">-- Select type of document --</option>
						</select>
					</div>
				</div>

				<div class="row mb-3">
					<label for="inputPassword3" class="col-sm-2 col-form-label">Confidentiality Code(s):
						<br />
						<em>Press Ctrl to select multiple</em>

					</label>
					<div class="col-sm-10">
						<select multiple size="8" asp-for="Metadata.ConfidentialityCodeList"
								asp-items="Model.SelectConfidentialityCodeList"
								class="form-control">
							@* <option value="">-- Select document's confidentiality level --</option> *@
						</select>
					</div>
				</div>

				<h4>
					<i id="AR1O9DG8K4UJR" class="bi bi-file-earmark-plus-fill fs-1 text-primary"></i>
					Additional document information (optional):
				</h4>

			</div>
		</div>

		<partial name="_PrevNextPartial" />

	</form>
</div>

