@model int 

@{
	var sessionLoginResult = Context.Session.SessionData();

	var totalsteps = 6; // TODO: read Length from "steps" in _PrevNextPartial, move the steps table to somewhere else
	
	var step = Model; 

	var percent = (step * 100) / totalsteps; 
}

<div style="max-width:1900px;margin:0 auto">

	<div class="container-fluid py-1">
		<h3 class="mb-4">Lagre dokument(er)</h3>

		<!-- Progress -->
		<div class="progress mb-3" style="height: 8px;">
			<div id="wizardProgress" class="progress-bar" role="progressbar" style="width: @percent%;"></div>
		</div>

		<!-- Step headers (pills) -->
		<ul class="nav nav-pills justify-content-between mb-4" id="wizardNav" role="tablist">
			@{
				var cssClass = "";
			}


			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 1 ? "active" : "disabled"; 
				}
				<a asp-action="Patient"  class="nav-link @cssClass" role="tab">1. Pasient</a>
			</li>
			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 3 ? "active" : "disabled";
				}
				<a asp-action="UploadDocument" class="nav-link @cssClass" id="step3-tab" tabindex="-1">2. Dokumenter</a>
			</li>
			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 2 ? "active" : "disabled";
				}
				<a asp-action="Classification" class="nav-link @cssClass" id="step2-tab" tabindex="-1">3. Klassifisering</a>
			</li>
			
			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 4 ? "active" : "disabled";
				}
				<a asp-action="Submission" class="nav-link @cssClass" id="step4-tab" tabindex="-1">4. Innsending</a> <!-- Inkludert association metadata -->
			</li>
			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 5 ? "active" : "disabled";
				}
				<a asp-action="FinalizeSubmission" class="nav-link @cssClass" id="step4-tab" tabindex="-1">5. Bekreft innsending</a>
			</li>
			<li class="nav-item" role="presentation">
				@{
					cssClass = step == 6 ? "active" : "disabled";
				}
				<a asp-action="SubmissionConfirmation" class="nav-link @cssClass" id="step4-tab" tabindex="-1">6. Ferdig</a>
			</li>
		</ul>


	</div>
</div>

