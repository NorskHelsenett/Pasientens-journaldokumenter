	string LookupDocumentReferenceStatusIcon(Lookup lookup)
	{
		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.NotRun)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.Running)
		{
			//return "<span style='color:green;font-weight:bold'><i class='bi bi-play'></i></span>";
			//return "<i class='bi bi-arrow-repeat spinner-icon big-spinner'></i>";
			return "<i class='bi bi-arrow-repeat spinner-icon'></i>";
			//return "<i class='bi bi-gear spinner-icon'></i>";
		}

		if (lookup.RetrieveDocumentReferenceIsSuccess)
		{
			return "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>";
		}
		else
		{
			return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		}

		// if (status == LookupStatus.Failed)
		// {
		// 	return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		// }

		//return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
	}

	string LookupDocumentStatusIcon(Lookup lookup)
	{
		if (lookup.OpenDocumentStatus == LookupDocumentStatus.NotRun)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

		if (lookup.OpenDocumentStatus == LookupDocumentStatus.Running)
		{
			//return "<span style='color:green;font-weight:bold'><i class='bi bi-play'></i></span>";
			//return "<i class='bi bi-arrow-repeat spinner-icon big-spinner'></i>";
			return "<i class='bi bi-arrow-repeat spinner-icon'></i>";
			//return "<i class='bi bi-gear spinner-icon'></i>";
		}

		if (lookup.OpenDocumentIsSuccess)
		{
			return "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>";
		}
		else
		{
			return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		}

		// if (status == LookupStatus.Failed)
		// {
		// 	return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		// }

		//return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
	}

	string LookupResultIcon(bool? expectSuccess, bool? isSuccess)
	{
		if (expectSuccess == null)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}
		if (expectSuccess == true)
		{
			if (isSuccess == null)
			{
				return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
			}
			return isSuccess == true ? "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>" : "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		}
		else
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

	}

	string LookupDocumentReferenceResultIcon(Lookup lookup)
	{
		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.NotRun)
		{
			return NotRunIcon();
		}

		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.Running)
		{
			return SpinnerIcon();
		}

		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.Visible)
		{
			return VisibleIcon();
		}

		if (lookup.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.NotVisible)
		{
			return InvisibleIcon();
		}

		return NotRunIcon();

		/*if (lookup.RetrieveDocumentReferenceExpectVisibleWithObfuscation == true)
		{
			if (lookup.RetrieveDocumentReferenceIsSuccessWithObfuscation == true)
			{
				return SuccessObfuscatedIcon();
			}
			else
			{
				return FailIcon();
			}
		}
		else if (lookup.RetrieveDocumentReferenceExpectVisible == true)
		{
			if (lookup.RetrieveDocumentReferenceIsSuccess == true)
			{
				return VisibleIcon();
			}
			else
			{
				return FailIcon();
			}
		}	 */
	}

	string LookupDocumentResultIcon(Lookup lookup)
	{
		if (lookup.OpenDocumentStatus == LookupDocumentStatus.NotRun)
		{
			return NotRunIcon();
		}

		if (lookup.OpenDocumentStatus == LookupDocumentStatus.Running)
		{
			return SpinnerIcon();
		}
		
		if (lookup.OpenDocumentIsSuccess == true)
		{
			return VisibleIcon();
		}
		else
		{
			return FailIcon();
		}
	}

	string SuccessIcon()
	{
		return "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>";
	}

	string SuccessObfuscatedIcon()
	{
		return "<span style='color:green;font-weight:bold'><i class='bi bi-asterisk'></i></span>";
	}

	string FailIcon()
	{
		return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
	}

	string NeutralIcon()
	{
		return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
	}

	string VisibleIcon()
	{
		return "<span style='color:green;font-weight:bold'><i class='bi bi-eye'></i></span>";
	}

	string InvisibleIcon()
	{
		return "<span style='color:red;font-weight:bold'><i class='bi bi-eye-slash'></i></span>";
	}

}


@{
	var rowClass = "";
	if (Model.Run.Status == DokumentlagerTestCaseStatus.NotRun)
	{
		rowClass = "row-not-run";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Queued)
	{
		rowClass = "row-queued";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Running)
	{
		rowClass = "row-running";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Success)
	{
		rowClass = "row-success";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Failed)
	{
		rowClass = "row-failed";
	}
}


<tr class="test-row @rowClass" data-test-index="@testIndex" data-group-index="@groupIndex">

	<td class="big-icon">
		@* @Html.Raw(OutcomeIcon(test.Result?.Success)) *@
		@Html.Raw(StatusIcon(Model.Run.Status))
		
	</td>
	<td>
		@test.Name
		<br />
		
		@* <div class="badge-running">
			RUNNING
		</div> *@

		@{
			if (Model.Run.Status == DokumentlagerTestCaseStatus.Running)
			{
				<div class="badge-running">
					RUNNING
				</div>
			}
		}
	</td>
	<td>@test.ExpectedResult</td>
	<td>@test.Comment</td>
	<td>
		@{
			var securityLabels = string.Join(' ', test.SecurityLabels);
		}

		<span>@securityLabels</span>

