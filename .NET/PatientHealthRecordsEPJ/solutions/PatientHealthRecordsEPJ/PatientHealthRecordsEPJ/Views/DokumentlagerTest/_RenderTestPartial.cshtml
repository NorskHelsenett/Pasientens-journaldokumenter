	string ShowJsonData(string json)
	{
		if (string.IsNullOrEmpty(json))
		{
			return "- ingen data -";
		}
		else
		{
			return json;
		}
	}

	string Active(bool? active)
	{
		return active == true ? "<span class='active'>AKTIV</span>" : "<span class='inactive'>IKKE AKTIV</span>";
	}

	string Blocked(bool? blocked)
	{
		return blocked == true ? "<span class='active'>JA, ER BLOKKERT</span>" : "<span class='inactive'>NEI, IKKE BLOKKERT</span>";
	}

	string OutcomeIcon(bool? success)
	{
		if (success == null)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

		return success == true ? "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>" : "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
	}

	string NotRunIcon()
	{
		return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		//return "<span style='color: gray; font-style:italic'><i class='bi bi-hourglass'></i></span>";
	}

	string SpinnerIcon()
	{
		return "<i class='bi bi-arrow-repeat spinner-icon'></i>";
	}

	string BigSpinnerIcon()
	{
		return "<i class='bi bi-arrow-repeat spinner-icon big-spinner'></i>";
	}

	string StatusIcon(DokumentlagerTestCaseStatus status)
	{
		if (status == DokumentlagerTestCaseStatus.NotRun)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

		if (status == DokumentlagerTestCaseStatus.Queued)
		{
			return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
		}

		if (status == DokumentlagerTestCaseStatus.Running)
		{
			//return "<span style='color:green;font-weight:bold'><i class='bi bi-play'></i></span>";
			return "<i class='bi bi-arrow-repeat spinner-icon big-spinner'></i>";
			//return "<i class='bi bi-gear spinner-icon'></i>";
		}

		if (status == DokumentlagerTestCaseStatus.Success)
		{
			return "<span style='color:green;font-weight:bold'><i class='bi bi-check-circle'></i></span>";
		}

		if (status == DokumentlagerTestCaseStatus.Failed)
		{
			return "<span style='color: red; font-weight:bold'><i class='bi bi-x-circle'></i></span>";
		}

		return "<span style='color: gray; font-style:italic'><i class='bi bi-rocket'></i></span>";
	}

