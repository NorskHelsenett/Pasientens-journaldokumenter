	string LookupDocumentResultIcon(Lookup lookup)
	{
		if (lookup.OpenDocumentStatus == LookupDocumentStatus.NotRun)
		{
			return NotRunIcon();
		}

		if (lookup.OpenDocumentStatus == LookupDocumentStatus.Running)
		{
			return SpinnerIcon();
		}

		if (lookup.OpenDocumentStatus == LookupDocumentStatus.OpenDocumentSuccess)
		{
			return VisibleIcon();
		}

		if (lookup.OpenDocumentStatus == LookupDocumentStatus.OpenDocumentFailed)
		{
			return InvisibleIcon();
		}

		return NotRunIcon();		
	}

