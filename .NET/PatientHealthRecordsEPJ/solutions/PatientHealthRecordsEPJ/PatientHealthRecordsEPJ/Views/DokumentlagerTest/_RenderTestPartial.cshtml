@{
	var rowClass = "";
	if (Model.Run.Status == DokumentlagerTestCaseStatus.NotRun)
	{
		rowClass = "row-not-run";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Queued)
	{
		rowClass = "row-queued";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Running)
	{
		rowClass = "row-running";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Success)
	{
		rowClass = "row-success";
	}

	if (Model.Run.Status == DokumentlagerTestCaseStatus.Failed)
	{
		rowClass = "row-failed";
	}
}


<tr class="test-row @rowClass" data-test-index="@testIndex" data-group-index="@groupIndex">

	<td class="big-icon">
		@* @Html.Raw(OutcomeIcon(test.Result?.Success)) *@
		@Html.Raw(StatusIcon(Model.Run.Status))
		
	</td>
	<td>
		@Html.Raw(test.Name.Replace("\n", "<br/>"))
		<br />
		
		@* <div class="badge-running">
			RUNNING
		</div> *@

		@{
			if (Model.Run.Status == DokumentlagerTestCaseStatus.Running)
			{
				<div class="badge-running">
					RUNNING
				</div>
			}
		}
	</td>
	@* <td>@test.ExpectedResult</td> *@
	@* <td>@test.Comment</td> *@
	<td>
		@{
			var securityLabels = string.Join(' ', test.SecurityLabels);
		}

		<span>@securityLabels</span>

	</td>
	<td>
		@* dokument *@
	</td>
	<td>
		@if (test.Lookup?.LookupDokumentlager != null)
		{
			// Saved to registry?

			if (test.Lookup.LookupDokumentlager.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.NotRun)
			{
				<div> - </div>
			}
			else if (test.Lookup.LookupDokumentlager.RetrieveDocumentReferenceStatus == LookupDocumentReferenceStatus.Running)
			{
				<div>
					@Html.Raw(LookupDocumentReferenceStatusIcon(test.Lookup.LookupDokumentlager)) Laster opp bundle
				</div>
			}
			else
			{
				if (test.Lookup.LookupDokumentlager.RetrieveDocumentReferenceIsSuccess)
				{
					<div>
						@Html.Raw(SuccessIcon()) Lagret til registry
					</div>
				}
				else
				{
					<div>
						@Html.Raw(FailIcon()) Ikke lagret til registry
					</div>
				}
			}

			// Saved to repository?
		
			if (test.Lookup.LookupDokumentlager.OpenDocumentIsSuccess)
			{
				<div>
					@Html.Raw(SuccessIcon()) Lagret til repository
				</div>
			}
			else
			{
				
			}
		}
	</td>
	<td>
		<table>
			@* <thead>
													<tr>

													</tr>
												</thead> *@
			<tbody>
				<tr>
					<td><div class="field">PurposeOfUse:</div> </td>
					<td>
						@test.PurposeOfUse
					</td>
				</tr>
			</tbody>

		</table>

	</td>
	<td>
		@if (test.Events != null && test.LookupAfterEvents != null)
		{
			<div class="events-title">
				Før hendelser
			</div>
		}

		<table class="table table-sm">
			<thead>
				<tr>
					<th> @* Ikon  *@</th>
					<th>Hvor</th>
					<th>Forventet</th>
					<th>Testet @* Faktisk *@ @* Resultat *@</th>
				</tr>
			</thead>
			<tbody>
				@if (test.Lookup?.LookupDokumentlager != null)
				{
					<tr>
						<td class="big-icon">@Html.Raw(LookupDocumentReferenceStatusIcon(test.Lookup.LookupDokumentlager))</td>
						<td>Dokumentlager</td>
						<td class="ex-icon">
							@if (test.Lookup.LookupDokumentlager.RetrieveDocumentReferenceExpectVisibleWithObfuscation == true)
							{
								<div>
									@Html.Raw(SuccessObfuscatedIcon())
								</div>
							}
							else
								if (test.Lookup.LookupDokumentlager.RetrieveDocumentReferenceExpectVisible == true)
								{
									<div>@Html.Raw(VisibleIcon())</div>
								}
								else
								{
									<div>@Html.Raw(InvisibleIcon())</div>
								}
						</td>
						<td class="re-icon">
							<div>
								@Html.Raw(LookupDocumentReferenceResultIcon(test.Lookup.LookupDokumentlager))
							</div>
						</td>
					</tr>
				}

				@if (test.Lookup?.LookupAPI != null)
				{
					<tr>
						@*<td class="big-icon">@Html.Raw(test.Lookup.LookupAPI.Success == true ? SuccessIcon() : FailIcon())</td>*@
						<td class="big-icon">@Html.Raw(LookupDocumentReferenceStatusIcon(test.Lookup.LookupAPI))</td>
						<td>REST API</td>
						<td class="ex-icon">
							@if (test.Lookup.LookupAPI.RetrieveDocumentReferenceExpectVisibleWithObfuscation == true)
							{
								<div>
									@Html.Raw(SuccessObfuscatedIcon())
								</div>
							}
							else
								if (test.Lookup.LookupAPI.RetrieveDocumentReferenceExpectVisible == true)
								{
									<div>@Html.Raw(VisibleIcon())</div>
								}
								else
								{
									<div>@Html.Raw(InvisibleIcon())</div>
								}
						</td>
						<td class="re-icon">
							<div>
								@Html.Raw(LookupDocumentReferenceResultIcon(test.Lookup.LookupAPI))
							</div>
						</td>
					</tr>
				}

				@if (test.Lookup?.LookupKJ != null)
				{
					<tr>
						<td class="big-icon">@Html.Raw(LookupDocumentReferenceStatusIcon(test.Lookup.LookupKJ))</td>
						<td>KJ portal</td>
						<td class="ex-icon">
							@if (test.Lookup.LookupKJ.RetrieveDocumentReferenceExpectVisibleWithObfuscation == true)
							{
								<div>
									@Html.Raw(SuccessObfuscatedIcon())
								</div>
							}
							else
								if (test.Lookup.LookupKJ.RetrieveDocumentReferenceExpectVisible == true)
								{
									<div>@Html.Raw(VisibleIcon())</div>
								}
								else
								{
									<div>@Html.Raw(InvisibleIcon())</div>
								}
						</td>
						<td class="re-icon">
							<div>
								@Html.Raw(LookupDocumentReferenceResultIcon(test.Lookup.LookupKJ))
							</div>
						</td>
					</tr>
				}

				@if (test.Lookup?.LookupHelsenorge != null)
				{
					<tr>
						<td class="big-icon">@Html.Raw(LookupDocumentReferenceStatusIcon(test.Lookup.LookupHelsenorge))</td>
						<td>Helsenorge</td>
						<td class="ex-icon">
							@if (test.Lookup.LookupHelsenorge.RetrieveDocumentReferenceExpectVisibleWithObfuscation == true)
							{
								<div>
									@Html.Raw(SuccessObfuscatedIcon())
								</div>
							}
							else
								if (test.Lookup.LookupHelsenorge.RetrieveDocumentReferenceExpectVisible == true)
								{
									<div>@Html.Raw(VisibleIcon())</div>
								}
								else
								{
									<div>@Html.Raw(InvisibleIcon())</div>
								}
						</td>
						<td class="re-icon">
							<div>
								@Html.Raw(LookupDocumentReferenceResultIcon(test.Lookup.LookupHelsenorge))
							</div>
						</td>
					</tr>
				}

			</tbody>
		</table>

		@if (test.Events != null)
		{
			<div class="events-title">
				Hendelser
			</div>

			<table class="table table-sm">
				<thead>
					<tr>
						<th> @* Ikon  *@</th>
						<th>Hvor</th>
						<th>Hendelse</th>
						<th>Forventet</th>
						<th>Testet @* Faktisk *@ @* Resultat *@</th>
					</tr>
				</thead>
				<tbody>
					@if (test.Events?.IsTrySimulateDeath == true)
					{
						<tr>
							<td class="big-icon">@Html.Raw(DeathStatusIcon(test.Events))</td>
							<td>Persontjenesten</td>
							<td>Død</td>
							<td class="ex-icon">
								@if (test.Events.SimulateDeathExpectScheduledDocumentDeletion)
								{
									<div>@Html.Raw(DeleteDocumentsAfter30DaysIcon())</div>
								}
							</td>
							<td class="re-icon">
								<div>
									@Html.Raw(DeathResultIcon(test.Events))
								</div>
							</td>
						</tr>
					}

					@if (test.Events?.IsTrySimulateAddressProtection == true)
					{
						<tr>
							<td class="big-icon">@Html.Raw(AddressProtectionStatusIcon(test.Events))</td>
							<td>PVK</td>
							<td>Adressesbeskyttelse</td>
							<td class="ex-icon">
