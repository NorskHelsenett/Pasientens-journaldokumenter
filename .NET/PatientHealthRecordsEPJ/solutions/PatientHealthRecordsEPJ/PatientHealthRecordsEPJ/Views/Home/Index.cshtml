@model HomeViewModel

@{
	var sessionData = Context.Session.SessionData();
}


<style>
	.sessionData
	{
		background-color: rgb(218, 218, 218); 
		border-radius:5px; 
		padding:4px; 
		font-size:18px; 
		/* font-weight:bold;  */
	}

	.fnr
	{
		color:darkgoldenrod; 
	}

	.actions a
	{
		display:inline-block;
		margin-bottom:1rem; 
	}
</style>

@if (!sessionData.IsAuthenticated)
{
	@if (string.IsNullOrEmpty(Model.AttestJson))
	{
		<form method="post" asp-action="LoginStep1">
			<div class="container">

				<div class="row">
					<div class="col-md-12">
						<h5>1. Velg miljø @* (<span class="environment test">TEST</span> og <span class="environment qa">QA</span> er tilgjengelig):  *@</h5>

						<div>
							@* <select asp-for="EnvironmentId"
									asp-items="@(new SelectList(PasientvalgViewModel.EnvironmentList, nameof(OptionPair.Id), nameof(OptionPair.Label)))"
									class="w-100">
							</select> *@

							@foreach (var env in PasientvalgViewModel.EnvironmentList)
							{
								var info = env.Id switch
								{
									"devtest" => "api-dev.pjd.test.nhn.no => pjd-ehs-dev.test.nhn.no",
									"test" => "api.pjd.test.nhn.no => pjd-ehs.test.nhn.no",
									"test-geo" => "viti-api.pjd.test.nhn.no => pjd-ehs.test.nhn.no",
									"qa" => "api.pjd.qa.nhn.no => pjd-ehs.qa.nhn.no",
									_ => ""
								};

								<div class="form-check">
									<input class="form-check-input"
										   type="radio"
										   asp-for="EnvironmentId"
										   value="@env.Id"
										   id="env_@env.Id" />

									<label class="form-check-label environment @env.Id" for="env_@env.Id">
										@env.Label  (@info)
									</label>
								</div>
							}

							@* <span asp-validation-for="EnvironmentId" class="text-danger"></span> *@

						</div>

					</div>
				</div>
				<div class="row">
					<div class="col-md-12">
						<br />

					</div>
				</div>

				<div class="row">
					<div class="col-md-12">
						<h5>2. Velg lovverk (scope for å hente dokumentliste): </h5>

						<div>
							<select asp-for="DocumentListScopeId"
									asp-items="@(new SelectList(PasientvalgViewModel.DocumentListScopeList, nameof(OptionPair.Id), nameof(OptionPair.Label)))"
									class="w-100">
							</select>
						</div>

					</div>
				</div>


				<div class="row">
					<div class="col-md-12">
						<br />
						<h5>3. Velg: </h5>
					</div>
				</div>

				<div class="row">
					<div class="col-md-6">
						<div>
							<strong>Virksomhet</strong>
						</div>
						<div>
							<select asp-for="OrganizationId"
									asp-items="@(new SelectList(HomeViewModel.OrganizationList, nameof(OptionPair.Id), nameof(OptionPair.Label)))"
									class="w-100">
							</select>
						</div>
					</div>
					@* <div class="col-md-4">
			<div>
			<strong>Bruker</strong>
			</div>
			<div>
			<input asp-for="HealthcarePersonellUserId" class="w-100" value="22047800106" />
			</div>
			</div> *@
					<div class="col-md-6">
						<div>
							<strong>Autorisasjon</strong>
						</div>
						<div>
							<select asp-for="AuthorizationId"
									asp-items="@(new SelectList(HomeViewModel.AuthorizationList, nameof(OptionPair.Id), nameof(OptionPair.Label)))"
									class="w-100">
							</select>
						</div>
					</div>
				</div>

				@if (sessionData.SourcePatientInfo != null)
				{
					<br />
					<h5>Pasient: </h5>
					<div>
						<table class="table w-auto">
							<tr>
								<td>Navn: </td>
								<td>@sessionData.SourcePatientInfo?.Name.ToString()</td>
							</tr>
							<tr>
								<td>Fødselsnummer: </td>
								<td>@sessionData.SourcePatientInfo?.NIN</td>
							</tr>
							<tr>
								<td>
									Bursdag:
								</td>
								<td>
									@if (sessionData.SourcePatientInfo?.DateOfBirth != default)
									{
										<span>
											@sessionData.SourcePatientInfo!.DateOfBirth.ToString("yyyy-MM-dd")
										</span>
									}
								</td>
							</tr>
							<tr>
								<td>Kjønn: </td>
								<td>@sessionData.SourcePatientInfo?.Gender</td>
							</tr>
						</table>
					</div>
				}

				<div class="row">
					<div class="col-md-12 text-center pt-3">
						<button type="submit" class="btn btn-primary" formaction="/Home/Login">Logg inn med HelseID @* <i class="bi-box-arrow-in-right"></i>  &rarr; *@ </button> eller
						<button type="submit" class="btn btn-primary">Rediger attest og Logg inn med HelseID  @* <i class="bi-box-arrow-in-right"></i>  &rarr; *@ </button>

					</div>
				</div>

			</div>
		</form>
	}
	else
	{
		@* Et unødvendig ekstra steg med mulighet til å redigere attesten direkte for man logger inn *@
		<form method="post" asp-action="LoginWithCustomizedAttest">
			<div class="container">

				<div>
					<h2 class="text-center">@Model.OrganizationName</h2>
				</div>

				<div class="fs-4">
					Bruker: @Model.HealthcarePersonellUserId &nbsp;&nbsp; Autorisasjon: @Model.AuthorizationName
				</div>

				<div class="row">
					<div class="col-md-12">
						<br />

						<p><strong>Attest:</strong></p>

						<textarea name="attestJson" class="w-100" rows="20">@Model.AttestJson</textarea>

					</div>
				</div>

				<div class="row">
					<div class="col-md-12 text-center pt-3">
						<a href="/" class="btn btn-primary"> &larr; Tilbake</a> &nbsp; &nbsp; &nbsp; &nbsp;
						<button type="submit" class="btn btn-primary">Logg inn med HelseID @* <i class="bi-box-arrow-in-right"></i>  &rarr; *@ </button>
					</div>
				</div>
			</div>
		</form>
	}
}
else
{
	<div class="container">
		<div class="row">
			<div class="col-md-12">

				<div class="sessionData">

					<table class="table table-borderless table-sm w-auto m-0">

						<tr>
							<td>
								Bruker:
							</td>
							<td>
								@sessionData.Name (<span class="fnr">@sessionData.PersonId</span>)
							</td>
						</tr>
						<tr>
							<td>
								Autorisasjon:
							</td>
							<td>
								@sessionData.AuthorizationName (@sessionData.AuthorizationId)
							</td>
						</tr>
						<tr>
							<td>
								Pasient:
							</td>
							<td>
								@if (string.IsNullOrEmpty(sessionData.PatientName))
								{
									<span class="fnr">
										@sessionData.PatientId
									</span>
								}
								else
								{
									<div>@sessionData.PatientName (<span class="fnr">@sessionData.PatientId</span>)</div>
								}
							</td>
						</tr>
						<tr>
							<td>
								Lovverk/scope for å hente dokumentliste:
							</td>
							<td>
								@sessionData.DocumentListScopeName
							</td>
						</tr>
						@if (sessionData.DocumentListScopeId == (int)DocumentListScopeEnum.Kjernejournalforskriften)
						{
							<tr>
								<td>
									Grunnlag:
								</td>
								<td>
									@sessionData.GrunnlagName
								</td>
							</tr>
						}

					</table>
				</div>
			
				<div class="text-center fs-3">
					<p>
						<a asp-asp-controller="patient" asp-controller="patient" asp-action="pasientvalg" class="btn btn-primary w-100"> &larr; Bytt pasient </a>						
					</p>
				</div>

				<div class="text-center fs-3">
					<p class="actions">
						@* <a asp-asp-controller="patient" asp-controller="patient" asp-action="pasientvalg" class="btn btn-primary"> &larr; Bytt pasient </a> *@
						<a href="/documents" class="btn btn-primary p-3">Åpne pasientens journaldokumenter i @sessionData.EnvironmentName &rarr;</a><br />
						<a href="/UploadDocuments" class="btn btn-primary p-3">Last opp dokumenter til NHN Dokumentlager i @sessionData.EnvironmentName &rarr;</a><br />
						<a asp-controller="Saml" asp-action="ShowSamlAssertion" class="btn btn-primary p-3"> Vis SAML billett &rarr;</a><br />
						<a asp-controller="Status" asp-action="Index" class="btn btn-primary p-3"> Vis status (personverninnstillinger) &rarr;</a><br />
					</p>
				</div>
			</div>
		</div>	

		<br />
		<br />
		<br />

		<div class="row text-center">
			<div class="col-md-6">				
							

				<h3>Logg inn i Helsenorge</h3>

				<div>
					Pasient: @sessionData.PatientName
				</div>

				<div class="fs-3">
					<p class="actions">						
						@{
							var hnLoginUrl = "https://tjenester.hn.test.nhn.no/?pnr=" + sessionData.PatientId; 
						}

						<a href="@hnLoginUrl" class="btn btn-primary p-3" target="_blank">Logg inn i Helsenorge &rarr;</a><br />						
					</p>
				</div>
			</div>

			<div class="col-md-6">

				<h3>Logg inn i Kjernejournal EPJ</h3>

				<div>
					Helsepersonell: @sessionData.Name
				</div>

				<div class="fs-3">
					<p class="actions">
						@{
							var kjLoginUrl = "https://epj.kj.nhn.no"; 
						}

						<a href="@kjLoginUrl" class="btn btn-primary p-3" target="_blank">Logg inn i Kjernejournal EPJ &rarr;</a><br />
					</p>
				</div>
			</div>
			
		</div>	

	</div>
}

