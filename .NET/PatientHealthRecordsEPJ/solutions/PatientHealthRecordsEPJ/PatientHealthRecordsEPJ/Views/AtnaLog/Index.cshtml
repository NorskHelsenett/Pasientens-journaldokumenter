@using Hl7.Fhir.Model

@model AtnaLogViewModel

@{
	var sessionData = Context.Session.SessionData();

	string ShowJsonData(string json)
	{
		if (string.IsNullOrEmpty(json))
		{
			return "- ingen data -";
		}
		else
		{
			return json;
		}
	}

	string Active(bool? active)
	{
		return active == true ? "<span class='active'>AKTIV</span>" : "<span class='inactive'>IKKE AKTIV</span>";
	}

	string Blocked(bool? blocked)
	{
		return blocked == true ? "<span class='active'>JA, ER BLOKKERT</span>" : "<span class='inactive'>NEI, IKKE BLOKKERT</span>";
	}

	string NoUrn(string? v)
	{
		if (string.IsNullOrWhiteSpace(v))
			return string.Empty;
		return v.StartsWith("urn:", StringComparison.OrdinalIgnoreCase) ? v.Split(':').Last() : v;
	}

	static string? TryGetContainedId(string? reference)
	{
		if (string.IsNullOrWhiteSpace(reference))
			return null;
		if (!reference.StartsWith("#", StringComparison.Ordinal))
			return null;
		return reference.Length > 1 ? reference.Substring(1) : null;
	}

	static Resource? FindContainedResourceById(IEnumerable<Resource>? contained, string? id)
	{
		if (contained == null || string.IsNullOrWhiteSpace(id))
			return null;
		return contained.FirstOrDefault(r => string.Equals(r.Id, id, StringComparison.Ordinal));
	}

	static string? FormatHumanName(HumanName? name)
	{
		if (name == null)
			return null;
		var given = name.Given != null ? string.Join(" ", name.Given.Where(g => !string.IsNullOrWhiteSpace(g))) : string.Empty;
		var family = name.Family ?? string.Empty;
		var full = (given + " " + family).Trim();
		return string.IsNullOrWhiteSpace(full) ? null : full;
	}

	static string? FindDeviceIdentifierValue(AuditEvent auditEvent, string identifierTypeText)
	{
		var device = auditEvent.Contained?.OfType<Device>().FirstOrDefault();
		if (device?.Identifier == null)
			return null;
		return device.Identifier.FirstOrDefault(i => string.Equals(i.Type?.Text, identifierTypeText, StringComparison.OrdinalIgnoreCase))?.Value;
	}

	static (string? name, string? id)? GetPatientText(AuditEvent auditEvent)
	{
		var entity = auditEvent.Entity;
		if (entity == null || entity.Count == 0)
			return (null, null);

		var patientEntity = entity.FirstOrDefault(e =>
			e.Role?.Code == "1" ||
			e.Role?.Display?.Contains("Patient", StringComparison.OrdinalIgnoreCase) == true ||
			e.What?.Reference?.Contains("Patient/", StringComparison.OrdinalIgnoreCase) == true ||
			e.What?.Reference?.StartsWith("#patient", StringComparison.OrdinalIgnoreCase) == true);

		if (patientEntity?.What == null)
			return (null, null);

		var containedId = TryGetContainedId(patientEntity.What.Reference);
		var containedPatient = FindContainedResourceById(auditEvent.Contained, containedId) as Patient;
		if (containedPatient != null)
		{
			var name = FormatHumanName(containedPatient.Name?.FirstOrDefault());
			var id = containedPatient.Identifier?.FirstOrDefault()?.Value;
			//if (!string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(id))
				//return $"{name} ({id})";
			return (name, id);
		}

		return (patientEntity.What.Display
			?? patientEntity.What.Identifier?.Value
			?? patientEntity.What.Reference, patientEntity.What.Identifier?.Value);
	}

	static (string Title, List<(string Type, string? Value)> Details) GetDocumentInfo(AuditEvent auditEvent)
	{
		var entity = auditEvent.Entity;
		if (entity == null || entity.Count == 0)
			return ("-", new());

		var docEntity = entity.FirstOrDefault(e =>
			e.What?.Reference?.StartsWith("DocumentReference/", StringComparison.OrdinalIgnoreCase) == true ||
			e.Role?.Display?.Contains("Report", StringComparison.OrdinalIgnoreCase) == true ||
			e.Role?.Code == "3" ||
			e.Type?.Code == "2");

		if (docEntity == null)
			return ("-", new());

		string? titleFromDetail = docEntity.Detail?.FirstOrDefault(d => string.Equals(d.Type, "title", StringComparison.OrdinalIgnoreCase))?.Value?.ToString();
		var title = titleFromDetail
			?? docEntity.Name
			?? docEntity.What?.Display
			?? docEntity.What?.Reference
			?? "-";

		var details = new List<(string Type, string? Value)>();
		if (docEntity.Detail != null)
		{
			foreach (var d in docEntity.Detail)
			{
				var value = d.Value?.ToString();
				details.Add((d.Type ?? "-", value));
			}
		}

		if (docEntity.What?.Reference != null)
			details.Insert(0, ("reference", docEntity.What.Reference));

		return (title, details);
	}

	static (string? OrgNrParent, string? ClientName, string? ClientId) GetClientInfo(AuditEvent auditEvent)
	{
		var entity = auditEvent.Entity;
		if (entity == null || entity.Count == 0)
			return (null, null, null);

		var clientEntity = entity.FirstOrDefault(e =>
			e.Role?.Code == "13" ||
			e.Role?.Display?.Contains("Security", StringComparison.OrdinalIgnoreCase) == true ||
			string.Equals(e.What?.Display, "client", StringComparison.OrdinalIgnoreCase));

		if (clientEntity?.Detail == null || clientEntity.Detail.Count == 0)
			return (null, null, null);

		string? GetDetail(string type) => clientEntity.Detail
			.FirstOrDefault(d => string.Equals(d.Type, type, StringComparison.OrdinalIgnoreCase))
			?.Value?.ToString();

		return (
			GetDetail("orgnr_parent"),
			GetDetail("client_name"),
			GetDetail("client_id")
		);
	}
}

<style>
	.head {
		font-size: 14px;
		font-style: italic;
	}

	tr.document-item {
		cursor: pointer;
	}

	tr.audit-event-detail {
		display: none;
	}

	iframe {
		width: 100%;
		height: 800px;
		/* border:none;  */
		border: 1px solid #aaa;
	}

	textarea {
		position: relative;
		color: black;
		height: auto;
	}

