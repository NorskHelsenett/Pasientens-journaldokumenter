@model GetDocumentReferenceViewModel

@{
	var sessionData = Context.Session.SessionData();
}

<div class="container-fluid max">

	<div class="row">
		<div class="col-md-12">

			<h3>Dokument referanse (@Model.DocumentReferenceId):</h3>
			<br />

			<div class="fs-5">

				<table class="table w-auto">
					<tbody>
						<tr>
							<td>Pasient:</td>
							<td>@sessionData.PatientName (@sessionData.PatientId)</td>	
						</tr>
						<tr>
							<td>Kilde:</td>
							<td>@Model.KildeInfo?.Name (@Model.KildeInfo?.HomeCommunityId)</td>
						</tr>						
					</tbody>
				</table>

			</div>

			<br />

			@if (!Model.IsSuccess)
			{
				<div class="container-fluid">
					<div class="row">
						<div class="col-md-12">
							<p>
								Error: @Model.ErrorMessage
							</p>
							<p>
								API response status code: @Model.ApiResult.StatusCode
							</p>
							<p>
								API response body:
								<pre>
							@Model.ApiResult.Body
						</pre>
							</p>
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="container-fluid">
					<div class="row">
						<div class="col-md-12">
							
								<textarea class="w-100" rows="30">@Model.DocumentReferenceJson</textarea>
						</div>
					</div>
				</div>
			}
		</div>
	</div>


</div>