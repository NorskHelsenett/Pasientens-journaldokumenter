@using Hl7.Fhir.Model

@model GetDocumentReferencesViewModel

@{	
	var sessionData = Context.Session.SessionData();
}

@{
	bool IsOid(string? system, string oid)
	{
		return system?.Replace("urn:oid:", string.Empty) == oid;
	}

	string NoUrn(string input)
	{
		if (string.IsNullOrEmpty(input))
		{
			return input;
		}

		return input.Replace("urn:uuid:", "").Replace("urn:oid:", "");
	}

	string GetInstitutionName(DocumentReference document)
	{
		foreach (var author in document.Author)
		{
			var contained = document.Contained.FirstOrDefault(contained => contained.Id == author.Reference.Replace("#", ""));

			if (contained is Organization)
			{
				var organization = contained as Organization;

				if (organization.Type != null)
				{
					var type = organization.Type.FirstOrDefault();

					var coding = type?.Coding.FirstOrDefault();

					if (coding != null)
					{
						if (IsOid(coding.System, Constants.Oid.OrganisasjonNummer))
						{
							return organization!.Name;
						}
					}
				}
			}
		}
		return "-"; // Ikke Tilgjengelig
	}
	
	string GetDepartmentName(DocumentReference document)
	{
		foreach (var author in document.Author)
		{
			var contained = document.Contained.FirstOrDefault(contained => contained.Id == author.Reference.Replace("#", ""));

			if (contained is Organization)
			{
				var organization = contained as Organization;
				if (organization.Type != null)
				{
					var type = organization.Type.FirstOrDefault();

					var coding = type?.Coding.FirstOrDefault();

					if (coding != null)
					{
						if (IsOid(coding.System, Constants.Oid.ReshId))
						{
							return organization!.Name;
						}
					}
				}
			}
		}
		return "-"; // Ikke Tilgjengelig
	}

	string GetAuthorName(DocumentReference document)
	{
		foreach (var authorRef in document.Author)
		{
			var contained = document.Contained.FirstOrDefault(contained => contained.Id == authorRef.Reference.Replace("#", ""));

			if (contained is Practitioner)
			{
				var author = contained as Practitioner;

				if (author.Name != null)
				{
					var humanName = author.Name.FirstOrDefault();

					var name = string.Join(' ', humanName.Given) + " " + humanName.Family;

					return name;
				}
			}
		}
		return "-"; // Ikke Tilgjengelig
	}	

	string? GetHomeCommunityId(DocumentReference document)
	{		
		var homeCommunityIdExtension = document.Extension.FirstOrDefault(x => x.Url == "http://ihe.net/fhir/StructureDefinition/ihe-homeCommunityId"); 

		var homeCommunityId = homeCommunityIdExtension?.Value.ToString();

		return homeCommunityId;
	}

	string? GetRepositoryUniqueId(DocumentReference document)
	{
		var contentComponent = document.Content.FirstOrDefault();

		if (contentComponent == null)
			return string.Empty;

		var attachment = contentComponent.Attachment;

		var repositoryUniqueIdExtension = attachment.Extension.FirstOrDefault(x => x.Url == "http://ihe.net/fhir/StructureDefinition/ihe-repositoryUniqueId");

		var repositoryUniqueId = repositoryUniqueIdExtension?.Value.ToString();

		return repositoryUniqueId;
	}
}

<style>
