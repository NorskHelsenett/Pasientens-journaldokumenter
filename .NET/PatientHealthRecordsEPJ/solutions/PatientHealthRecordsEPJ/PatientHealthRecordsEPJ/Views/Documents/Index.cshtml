											</div>

											@* Åpne / kopier referanse *@

											@{
												var uri = new Uri(attachment.Url);

												//var openUrl = $"document{uri.Query}"; // Kaller DocumentController->Index metoden for å vise dokument
												var openUrl = $"document?url={System.Web.HttpUtility.UrlEncode(uri.ToString())}"; // Kaller DocumentController->Index metoden for å vise dokument
												//var deleteUrl = $"documents/DeleteDocument?documentUniqueId={documentUniqueId}&homeCommunityId={homeCommunityId}"; // Kaller DocumentsController->Delete metoden for å slette dokument
												var deleteUrl = $"documents/DeleteDocument?id={documentReferenceId}&homeCommunityId={homeCommunityId}"; // Kaller DocumentsController->Delete metoden for å slette dokument
												var getDocumentReferenceUrl = $"documents/GetDocumentReference?id={documentReferenceId}&homeCommunityId={homeCommunityId}"; // Kaller DocumentsController->GetDocumentReference metoden for å hente dokumentreferanse
											}
											<div>
												<a class="btn btn-primary" href="@openUrl" target="_blank">Åpne</a>

												@if (kildeInfo != null)
												{
													<span> | </span>
													<a class="btn btn-primary" href="@getDocumentReferenceUrl" target="_blank">Hent dokumentreferanse</a><br />
													<span> | </span>
													<a class="btn btn-primary" href="@deleteUrl" onclick="javascript:return confirm('Er du sikker på at du vil slette denne dokumentreferansen og dokumentet?')">Slett</a><br />
												}
												@* <button class="btn btn-primary">Kopier referanse</button><br /> *@
											</div>

										</div>

									</td>
								</tr>

							}
						</tbody>
						<tfoot>
						</tfoot>
					</table>

					@{
						if (haveAnyNasjonaltLager)
						{
							<div>
								<strong>Kilde: NL = Nasjonalt lager (NHN Dokumentlager)</strong>
								<br />
								<br />
							</div>
						}

						if (haveAnyRelatesTo)
						{
							<div>
								<strong>Info kolonne: Informasjon om oppdatering/erstatning av eksisterende dokument, tillegg til eksisterende, transformering, signering </strong>
								<br />
