ARG MCR_REG=mcr.microsoft.com
FROM $MCR_REG/dotnet/sdk:6.0 AS build-env

WORKDIR /stage

# Copy everything
COPY . .

# Restore and build apps
RUN dotnet restore src/Dodsmelding.sln
# Build and publish a release
RUN dotnet publish ./src/Dodsmelding.Api/Dodsmelding.Api.csproj -c Release -o /app --no-restore

# Build runtime image
FROM $MCR_REG/dotnet/aspnet:6.0-alpine as final

# Args
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=dodsmelding
ARG GROUP_NAME=dodsmelding

# Setup environment
ENV TZ="Europe/Oslo"
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

RUN apk add --no-cache icu-libs

# Add group and user
RUN addgroup --gid $GROUP_ID $GROUP_NAME && adduser --shell /sbin/nologin --disabled-password --no-create-home -G $GROUP_NAME --uid $USER_ID $USER_NAME

WORKDIR /app

# Copy files
COPY --from=build-env /app .

# Remove any appsettings.*.json files. All config should come from env variables in manifest repo.
RUN rm appsettings*.json

# Set user
USER $USER_ID

# Opt out of the diagnostic pipeline, allowing the container to run as read-only: https://learn.microsoft.com/en-us/dotnet/core/docker/build-container?tabs=windows#create-the-dockerfile
ENV DOTNET_EnableDiagnostics=0

ENTRYPOINT [ "dotnet", "Dodsmelding.Api.dll" ]
